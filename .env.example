WATCH_TOWER_DB_PASSWORD=replace-with-a-random-secret
AVATAR_HSM_READ_TOKEN=replace-with-a-random-secret
AVATAR_HSM_CONTROL_TOKEN=replace-with-a-different-random-secret
FITNESS_OWNER_ID=replace-with-the-provisioned-fitness-owner-id

# Optional Oura webhook subscription management. The callback is received and
# signature-checked by HSM; Watch Tower manages Oura's subscription lifecycle.
# AVATAR_WEARABLE_PUBLIC_URL=https://health.example.com
# AVATAR_OURA_CLIENT_ID=replace-with-oura-client-id
# AVATAR_OURA_CLIENT_SECRET=replace-with-oura-client-secret
# AVATAR_OURA_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-verification-token

# Optional COROS FIT provider intake. HSM owns per-user OAuth credentials and
# approves signed download hosts; Watch Tower performs detail/FIT HTTP requests.
# AVATAR_COROS_ACCESS_TOKEN=replace-with-a-coros-access-token
# AVATAR_COROS_OPEN_ID=replace-with-the-coros-open-id
# AVATAR_COROS_FIT_HOSTS=approved-cdn.example.com,another-cdn.example.com

# OpenFGA is required for person-scoped authorization for both OpenHuman and
# direct clients. Use a local test store for local-only checks, or the deployed
# OpenFGA service. Provision its store/model and role tuples before MCP calls.
# OPENFGA_API_URL=https://openfga.example.com
# OPENFGA_STORE_ID=replace-with-the-provisioned-store-id
# OPENFGA_AUTHORIZATION_MODEL_ID=replace-with-the-provisioned-model-id
# OPENFGA_API_TOKEN=replace-with-the-openfga-service-token

# Direct Gemini/ChatGPT OAuth profile: uncomment and replace only after
# Keycloak and the public HTTPS reverse proxy are configured. The OIDC client
# allowlist contains the actual OAuth client IDs for those clients.
# OpenHuman currently uses a private service bearer and the separate
# `openhuman-local` identity link; it is not an OIDC client ID here.
# WATCH_TOWER_REQUIRE_OPENHUMAN_IDENTITY=1
# WATCH_TOWER_PUBLIC_URL=https://health.example.com
# WATCH_TOWER_OIDC_ISSUER=https://identity.example.com/realms/health
# WATCH_TOWER_OIDC_AUDIENCE=health-watch-tower
# WATCH_TOWER_OIDC_JWKS_URL=https://identity.example.com/realms/health/protocol/openid-connect/certs
# WATCH_TOWER_OIDC_CLIENT_IDS=gemini-watch-tower,chatgpt-watch-tower
# The default OpenHuman-to-Watch-Tower URL uses private Compose networking.
# For production, set this to the same public HTTPS origin used by direct clients.
